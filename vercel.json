{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/gu-icsdi-2026/browser",
  "installCommand": "npm install",
  "framework": null,
  "routes": [
    { "src": "/(img/.*)", "dest": "/$1" },
    { "src": "/(favicon\\.ico|favicon\\.png|apple-touch-icon\\.png|robots\\.txt)", "dest": "/$1" },
    { "src": "/(.*)", "dest": "/construction.html" }
  ]
}
